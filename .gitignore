# Python build artifacts
__pycache__/
*.pyc

# Node dependencies
node_modules/

# Virtual environments
.venv/

# Claude
# Ignore .claude CONTENTS, not the directory itself: git cannot re-include a
# path inside an excluded directory, so a blanket `.claude/` would silently
# swallow the version-controlled skills below no matter what negation follows.
.claude/*
!.claude/skills/

# Cursor (keep .cursor/rules/ for project; skills stay local, not pushed)
.cursor/*
!.cursor/rules/

# Generated by workflows
feed.xml

# Credentials (never push)
newsletter/scripts/.env
newsletter/scripts/.substack-cookies.json
newsletter/scripts/.curriculum-cookies.json

# Published output (contains CDN URLs and draft IDs)
newsletter/published/

# Converted PNGs (generated from SVGs, not source)
newsletter/plots/png/

# ── Credential files: every shape, not just the common one ──────────────────
# Covers every credential-file shape seen in a repo-wide sweep, not just `.env`.
#
# The bare-`env` rules are root-anchored on purpose: some repos here have a
# real src/lib/env.ts, and a pattern like `env.*` would shadow source. A rule
# that fights the codebase is a rule someone deletes wholesale, taking the
# credential coverage with it.
.env
.env.*
!.env.example
!.env.sample
*.env
.envrc
/env
/env.local
/env.production
/env.development
