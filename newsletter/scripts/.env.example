# Substack Session (cookie-based, no password)
# Copy this file to .env and fill in real values. Never commit .env.
#
# How to get cookies:
# 1. Log in to https://substack.com (Google SSO or magic link)
# 2. DevTools -> Application -> Cookies -> https://substack.com
# 3. Copy the full cookie header string (all cookies for the domain)

# Full cookie header string from DevTools (current scheme used by code and CI)
SUBSTACK_COOKIES="substack.sid=PLACEHOLDER; connect.sid=PLACEHOLDER"

# Account email associated with the Substack login
SUBSTACK_EMAIL=you@example.com

# Note: create_draft.py also still accepts the legacy SUBSTACK_SID / CONNECT_SID
# variable names as a fallback, but SUBSTACK_COOKIES is preferred.
